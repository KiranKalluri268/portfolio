# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

REFACTOR_SUMMARY.md
SCROLL_ANALYSIS.md
ANIMATION_IMPLEMENTATION.md

# Playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Design references — sketches and screenshots the work is checked against,
# kept locally rather than shipped in the bundle.
public/reference/

# Scratch space for profiling and benchmark runs. These hold whole copies of
# .next for before/after comparison, so they run to tens of thousands of files.
/.perf-tmp
/*.profile
/*.cpuprofile
/*.heapsnapshot
