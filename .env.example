# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Messages from the portfolio contact form are delivered here.
CONTACT_EMAIL=you@example.com

# Optional. Keep the default sender until you verify your own domain in Resend.
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Content admin (/admin) - see docs/CONFIGURATION.md for how each is generated.
ADMIN_PASSWORD=choose-a-real-password
ADMIN_SESSION_SECRET=run-openssl-rand--hex-32-and-paste-the-output
GITHUB_ADMIN_TOKEN=github_pat_scoped_to_just_this_repo

# Optional - only needed if the repo is ever renamed or forked.
# GITHUB_REPO_OWNER=KiranKalluri268
# GITHUB_REPO_NAME=portfolio
